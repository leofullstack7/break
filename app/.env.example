# ============================================================
# BREAK DIGITAL — Variables de entorno
# Copiar este archivo a .env.local y llenar los valores
# NUNCA commitear .env.local al repositorio
# ============================================================

# ── SUPABASE ─────────────────────────────────────────────────
# Obtener en: supabase.com → proyecto → Settings → API
VITE_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica

# ── APP ──────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=Break Hotel

# Enlace directo para reseñas de Google (botón del chat por QR)
# VITE_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=TU_PLACE_ID

# Panel PxSol Conversaciones (WhatsApp + bot). Deep-link a chat concreto no está
# documentado; abrimos el PMS con pistas (booking_id / phone / nombre).
VITE_PXSOL_CONVERSACIONES_URL=https://pms.pxsol.com/

# ── GOOGLE MAPS (solo lectura, restringida por dominio) ──────
VITE_GOOGLE_MAPS_KEY=tu_google_maps_api_key

# ── GOOGLE ANALYTICS 4 ───────────────────────────────────────
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── META PIXEL ───────────────────────────────────────────────
VITE_META_PIXEL_ID=tu_pixel_id

# ── SENTRY (monitoreo de errores) ────────────────────────────
# Agregar cuando el proyecto esté en producción
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# ============================================================
# VARIABLES DE SERVIDOR (Edge Functions de Supabase)
# Configurar en: Supabase Dashboard → Edge Functions → Secrets
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=    ← NUNCA en el cliente
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_SECRET=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=hola@breakmanizales.com
#
# PXSOL_API_KEY=
# PXSOL_BASE_URL=https://gateway-dev.pxsol.com/v2
# SIIGO_USERNAME=
# SIIGO_ACCESS_KEY=
# SIIGO_PARTNER_ID=BreakDigitalPxsol
# SIIGO_CONSUMIDOR_FINAL_ID=
# SIIGO_DOCUMENT_TYPE_ID=
# SIIGO_DEFAULT_SELLER_ID=
